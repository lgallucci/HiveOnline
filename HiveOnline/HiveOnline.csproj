<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>HiveOnline</AssemblyName>
    <Product>Hive Online</Product>
    <AssemblyTitle>Hive Online</AssemblyTitle>
    <Description>Play the Hive board game against the computer, a friend, or online.</Description>
    <Company>lgallucci</Company>
    <Authors>lgallucci</Authors>
    <Copyright>Copyright © 2026 lgallucci</Copyright>
    <Version>1.0.1</Version>
    <InformationalVersion>1.0.1</InformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icon.bmp" />
    <None Remove="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.bmp" />
    <EmbeddedResource Include="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HiveClient\HiveClient.csproj" />
    <ProjectReference Include="..\HiveGraphics\HiveGraphics.csproj" />
    <ProjectReference Include="..\HiveLib\HiveLib.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  
  <ItemGroup>
    <None Update="Game.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
